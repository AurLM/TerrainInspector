<Project Sdk="Microsoft.NET.Sdk">
  <!-- A small Windows window around terrain-inspector.html.
       .NET Framework 4.8 is built into Windows 10 and 11, so users install nothing for it. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Terrain Inspector</AssemblyName>
    <RootNamespace>TerrainInspector</RootNamespace>
    <Product>Terrain Inspector</Product>
    <Description>Finds and fixes terrain seams in a Skyrim load order.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <!-- lets the build machine compile for .NET Framework 4.8 without the separate developer pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
